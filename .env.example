# ==============================================================================
# Synapse Framework - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.
# ==============================================================================

# Model Endpoints (Local Ollama / Remote LLMs)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:0.5b"
# GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# Storage & Graph Defaults
CHROMA_PERSIST_DIR="./data/chroma_db"
GRAPH_FILE_PATH="./data/graph.json"

# Connector Settings (Optional)
GMAIL_CREDENTIALS_PATH="./credentials.json"
GMAIL_TOKEN_PATH="./token.json"
NOTION_API_KEY=""
